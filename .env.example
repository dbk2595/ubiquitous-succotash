# ===== 必填(Vercel KV 数据库) =====
# 在 Vercel dashboard → Storage → Create → KV(免费 256MB / 10000 命令/天)
# 创建后会自动注入这两个环境变量,无需手动复制
KV_REST_API_URL=https://xxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxx

# ===== 可选 =====
# 管理员密码(默认 200212,建议改成自己的)
ADMIN_PWD=200212

# ===== 本地开发 =====
# 不配 KV_* 变量时,自动用本地 data.json 文件存储
# npm start 即可,无需 Vercel 账号
